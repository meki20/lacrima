# Lacrima has two private entry points:
#
# - http://<LAN IP>:7345 serves the local network without any certificate setup.
# - Tailscale Serve provides an HTTPS route over the tailnet.
#
# Start the tailnet route on the host after Caddy is running:
#
#      tailscale serve --bg --https=443 http://127.0.0.1:7345
#
# Serve provisions and renews the Tailscale certificate itself. Caddy only sees
# its local HTTP request, so the LAN route never depends on certificate files.

(lacrima) {

	encode zstd gzip

	# Page images are immutable and large; let Caddy hold the connection open
	# long enough for a source that is slow to first byte.
	reverse_proxy lacrima:3000 {
		flush_interval -1
		transport http {
			response_header_timeout 120s
		}
	}
}

:80 {
	import lacrima
}
